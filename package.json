{
  "name": "desko",
  "version": "0.1.0",
  "description": "Beautiful task manager CLI with ansimax",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --minify --sourcemap ./src/index.ts --outfile desko",
    "start": "bun src/index.ts",
    "build:release": "bun run scripts/build-release.ts",
    "build:linux-x64": "bun run scripts/build-release.ts linux-x64",
    "build:macos-arm64": "bun run scripts/build-release.ts macos-arm64",
    "build:macos-x64": "bun run scripts/build-release.ts macos-x64",
    "build:windows-x64": "bun run scripts/build-release.ts windows-x64"
  },
  "dependencies": {
    "ansimax": "^1.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^26.1.1",
    "bun-types": "^1.0.0"
  }
}